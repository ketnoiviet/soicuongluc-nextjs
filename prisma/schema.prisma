// ============================================================================
// HARIFA — Schema chuẩn hoá (Phase 2/3 của kế hoạch tái cấu trúc DB)
//
// File này là bản THIẾT KẾ MỚI, chưa được áp dụng — không ghi đè
// prisma/schema.prisma đang chạy dev.db hiện tại. Xem báo cáo audit đầy đủ
// (đối chiếu từng cột cũ ↔ mới + lý do) tại:
// https://claude.ai/code/artifact/556a62b8-20ab-47c9-bda3-cc42d9f6c711
//
// Naming convention:
//   - Model: PascalCase số ít               (Product, ProductCategory...)
//   - Bảng DB (@@map): snake_case số nhiều  (products, product_categories...)
//   - Field: camelCase                      (categoryId, createdAt...)
//   - Cột DB (@map): snake_case số ít       (category_id, created_at...)
//   - Khoá ngoại: <model_singular>Id ORM ↔ <table_singular>_id DB
//
// LƯU Ý VỀ ENUM: connector "sqlite" của Prisma KHÔNG hỗ trợ `enum` thật
// (enum chỉ chạy được trên postgresql/mysql/cockroachdb). Các trường dưới
// đây đóng vai trò enum đều khai báo kiểu `String` kèm doc-comment liệt kê
// đầy đủ giá trị hợp lệ — ràng buộc kiểu union ở tầng TypeScript (xem
// `lib/enums.ts` cần tạo ở bước áp dụng) chứ không phải ở tầng DB.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// SẢN PHẨM
// ============================================================================

/// Xoá 1 Supplier phải xoá theo toàn bộ Product của supplier đó (yêu cầu nghiệp vụ -
/// không phải mồ côi categoryId=null như khi xoá category) - xử lý thủ công trong
/// action (dọn file ảnh vật lý trước) rồi mới xoá record, không dùng onDelete: Cascade
/// ở DB vì Cascade sẽ xoá thẳng DB row mà bỏ qua bước dọn file trên đĩa.
model Supplier {
  id              Int     @id @default(autoincrement())
  name            String
  logoUrl         String? @map("logo_url")
  website         String?
  descriptionHtml String? @map("description_html")

  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("suppliers")
}

model ProductCategory {
  id       Int    @id @default(autoincrement())
  parentId Int?   @map("parent_id")
  name     String
  slug     String @unique

  sortOrder Int @default(0) @map("sort_order")
  /// Cấp trong cây danh mục (1 = gốc, 2 = con...). Tính lại khi đổi parentId,
  /// giữ làm cột lưu cứng như bản cũ để không phá vỡ logic orderBy hiện có.
  level     Int @default(1)

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  /// Thay thế cặp cờ (hien_thi, hieu_luc) cũ — xem giải thích ánh xạ trong báo cáo audit.
  status String @default("PUBLISHED")

  imageUrl         String? @map("image_url")
  shortDescription String? @map("short_description")
  /// Có RichTextEditor ở admin, hiện chưa hiển thị trên trang public —
  /// giữ lại theo yêu cầu, cần bổ sung UI hiển thị ở phase phát triển sau.
  descriptionHtml  String? @map("description_html")

  createdAt DateTime @default(now()) @map("created_at")

  parent   ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("ProductCategoryTree")
  products Product[]

  @@map("product_categories")
}

model Product {
  id         Int     @id @default(autoincrement())
  categoryId Int?    @map("category_id")
  sortOrder  Int     @default(0) @map("sort_order")
  /// Mã sản phẩm nội bộ — không hiển thị công khai trên site.
  sku        String? @unique
  name       String
  slug       String  @unique

  supplierId Int? @map("supplier_id")

  thumbnailUrl       String? @map("thumbnail_url")
  coverImageUrl      String? @map("cover_image_url")
  shortDescription   String? @map("short_description")
  descriptionHtml    String? @map("description_html")
  specificationsHtml String? @map("specifications_html")
  applicationsHtml   String? @map("applications_html")

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status     String  @default("PUBLISHED")
  isFeatured Boolean @default(false) @map("is_featured")
  isNew      Boolean @default(false) @map("is_new")
  isOnSale   Boolean @default(false) @map("is_on_sale")

  /// B2B công nghiệp — cố ý không bắt buộc hiển thị giá công khai,
  /// khách "yêu cầu báo giá" qua ContactSubmission (inquiryType = "QUOTE_REQUEST").
  price     Float?
  salePrice Float?  @map("sale_price")
  unit      String?

  /// SEO — mặc định lấy theo name/shortDescription nếu để trống, có thể ghi đè riêng.
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  /// Từ khoá chính dùng để chấm điểm SEO ở trang admin (không hiển thị công khai).
  focusKeyword    String? @map("focus_keyword")

  createdAt DateTime @default(now()) @map("created_at")

  category   ProductCategory?   @relation(fields: [categoryId], references: [id])
  supplier   Supplier?          @relation(fields: [supplierId], references: [id])
  images     ProductImage[]
  dimensions ProductDimension[]
  redirects  ProductRedirect[]

  @@map("products")
}

/// URL cũ của sản phẩm sau khi đổi slug — trang public tra bảng này để
/// chuyển hướng 301/308 (permanentRedirect) sang slug hiện tại thay vì trả 404.
model ProductRedirect {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  oldSlug   String   @unique @map("old_slug")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_redirects")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  sortOrder Int     @default(0) @map("sort_order")
  imageUrl  String  @map("image_url")
  altText   String? @map("alt_text")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

/// Bảng con kích thước — 1 sản phẩm có nhiều biến thể kích thước/quy cách.
/// Thay thế 6 cột rời chieu_rong/chieu_dai/chieu_cao/duong_kinh/chu_vi/trong_luong
/// trên bảng san_pham cũ. Cố ý chỉ 1 field text tự do (không chuẩn hoá đơn vị).
model ProductDimension {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")
  sortOrder Int    @default(0) @map("sort_order")
  /// VD: "Φ 1.5mm × 100m/cuộn"
  value     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_dimensions")
}

// ============================================================================
// TIN TỨC
// ============================================================================

model NewsCategory {
  id        Int    @id @default(autoincrement())
  parentId  Int?   @map("parent_id")
  name      String
  slug      String @unique
  sortOrder Int    @default(0) @map("sort_order")

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status String @default("PUBLISHED")

  /// Giữ lại theo yêu cầu (nhập mô tả danh mục qua RichTextEditor),
  /// hiện chưa hiển thị trên trang public — cần bổ sung UI sau.
  descriptionHtml String? @map("description_html")

  createdAt DateTime @default(now()) @map("created_at")

  parent   NewsCategory?  @relation("NewsCategoryTree", fields: [parentId], references: [id])
  children NewsCategory[] @relation("NewsCategoryTree")
  articles NewsArticle[]

  @@map("news_categories")
}

model NewsArticle {
  id         Int    @id @default(autoincrement())
  categoryId Int?   @map("category_id")
  sortOrder  Int    @default(0) @map("sort_order")
  title      String
  slug       String @unique

  thumbnailUrl  String? @map("thumbnail_url")
  coverImageUrl String? @map("cover_image_url")
  excerpt       String?
  contentHtml   String? @map("content_html")

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status String @default("PUBLISHED")

  /// Field sống thật duy nhất trong nhóm "hit-counter" cũ — tăng biến khi
  /// xem chi tiết bài viết, hiển thị "lượt xem" trên trang public.
  viewCount   Int      @default(0) @map("view_count")
  publishedAt DateTime @default(now()) @map("published_at")
  author      String?
  /// Chưa có nơi nhúng video ở public site — giữ lại, hoàn thiện hiển thị sau.
  videoUrl    String?  @map("video_url")

  category NewsCategory? @relation(fields: [categoryId], references: [id])

  @@map("news_articles")
}

// ============================================================================
// GIỚI THIỆU
// ============================================================================

/// Danh sách bài viết Giới thiệu (menu "Giới thiệu" ở public site trỏ tới danh
/// sách này thay vì 1 trang tĩnh cố định như trước) - không có category, phẳng
/// như NewsArticle nhưng bớt các field không cần (excerpt/author/viewCount...).
model AboutArticle {
  id        Int    @id @default(autoincrement())
  sortOrder Int    @default(0) @map("sort_order")
  title     String
  slug      String @unique

  thumbnailUrl String? @map("thumbnail_url")
  contentHtml  String? @map("content_html")

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status String @default("PUBLISHED")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("about_articles")
}

// ============================================================================
// GIAO DIỆN
// ============================================================================

model BannerSlide {
  id        Int     @id @default(autoincrement())
  sortOrder Int     @default(0) @map("sort_order")
  imageUrl  String  @map("image_url")
  linkUrl   String? @map("link_url")
  caption   String?

  @@map("banner_slides")
}

/// Chưa có UI hiển thị ở public site — giữ nguyên trong schema theo yêu cầu
/// để phát triển tiếp, không xoá khỏi thiết kế.
model AdPanel {
  id        Int     @id @default(autoincrement())
  sortOrder Int     @default(0) @map("sort_order")
  imageUrl  String? @map("image_url")
  linkUrl   String? @map("link_url")
  widthPx   Int?    @map("width_px")
  heightPx  Int?    @map("height_px")

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status String @default("PUBLISHED")

  @@map("ad_panels")
}

// ============================================================================
// MARKETING (trang chủ)
// ============================================================================

model WhyChooseUsItem {
  id          Int     @id @default(autoincrement())
  sortOrder   Int     @default(0) @map("sort_order")
  title       String
  description String?
  iconUrl     String? @map("icon_url")

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status String @default("PUBLISHED")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("why_choose_us_items")
}

model Testimonial {
  id           Int     @id @default(autoincrement())
  sortOrder    Int     @default(0) @map("sort_order")
  customerName String  @map("customer_name")
  /// Chức vụ / công ty khách hàng - vd "Giám đốc mua hàng, Công ty ABC"
  position     String?
  avatarUrl    String? @map("avatar_url")
  /// 1-5 sao
  rating       Int     @default(5)
  content      String?

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status String @default("PUBLISHED")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("testimonials")
}

model Faq {
  id         Int     @id @default(autoincrement())
  sortOrder  Int     @default(0) @map("sort_order")
  question   String
  answerHtml String? @map("answer_html")

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status String @default("PUBLISHED")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("faqs")
}

/// Logo đối tác / khách hàng tiêu biểu hiển thị dạng dải logo ở trang chủ - cố ý tối
/// giản (không có mô tả/richtext) đúng theo 3 field yêu cầu: tên, logo, website.
model Partner {
  id        Int     @id @default(autoincrement())
  sortOrder Int     @default(0) @map("sort_order")
  name      String
  logoUrl   String? @map("logo_url")
  website   String?

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status String @default("PUBLISHED")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("partners")
}

// ============================================================================
// TRANG NỘI DUNG (Quy định chung, Chính sách bảo mật, Chính sách bảo hành...)
// ============================================================================

model ContentPage {
  id          Int     @id @default(autoincrement())
  sortOrder   Int     @default(0) @map("sort_order")
  title       String
  slug        String  @unique
  contentHtml String? @map("content_html")

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status String @default("PUBLISHED")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("content_pages")
}

// ============================================================================
// THƯ VIỆN (ẢNH & VIDEO)
// ============================================================================

/// Album ảnh - ảnh thật nằm ở GalleryPhoto, album chỉ giữ metadata + thứ tự.
/// Ảnh đại diện album lấy từ ảnh có sortOrder nhỏ nhất trong GalleryPhoto, không
/// lưu field riêng để tránh phải đồng bộ 2 nơi khi thêm/xoá/sắp xếp lại ảnh.
model GalleryAlbum {
  id        Int    @id @default(autoincrement())
  sortOrder Int    @default(0) @map("sort_order")
  title     String

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status String @default("PUBLISHED")

  createdAt DateTime @default(now()) @map("created_at")

  photos GalleryPhoto[]

  @@map("gallery_albums")
}

model GalleryPhoto {
  id        Int    @id @default(autoincrement())
  albumId   Int    @map("album_id")
  sortOrder Int    @default(0) @map("sort_order")
  imageUrl  String @map("image_url")

  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@map("gallery_photos")
}

model Video {
  id        Int     @id @default(autoincrement())
  sortOrder Int     @default(0) @map("sort_order")
  title     String?

  thumbnailUrl String? @map("thumbnail_url")
  videoUrl     String  @map("video_url")

  /// enum VideoSource: "YOUTUBE" | "FACEBOOK" | "OTHER" - tự nhận dạng từ videoUrl khi lưu (xem lib/video.ts)
  videoSource String @default("OTHER") @map("video_source")

  descriptionHtml String? @map("description_html")

  /// enum ContentStatus: "PUBLISHED" | "HIDDEN" | "ARCHIVED"
  status String @default("PUBLISHED")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("videos")
}

// ============================================================================
// KHÁCH HÀNG
// ============================================================================

model ContactSubmission {
  id Int @id @default(autoincrement())

  /// enum InquiryType: "GENERAL_CONTACT" (form Liên hệ, id_loai cũ = 1)
  ///                 | "QUOTE_REQUEST"   (form Đặt hàng, id_loai cũ = 2)
  inquiryType String @default("GENERAL_CONTACT") @map("inquiry_type")

  fullName    String? @map("full_name")
  address     String?
  phoneNumber String? @map("phone_number")
  email       String?
  subject     String?
  message     String?

  /// enum ContactStatus: "PENDING" (status cũ = 0) | "RESOLVED" (status cũ = 1)
  status String @default("PENDING")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}

// ============================================================================
// HỆ THỐNG
// ============================================================================

model AdminUser {
  id           Int     @id @default(autoincrement())
  fullName     String? @map("full_name")
  email        String  @unique
  /// bcrypt hash — tên rõ nghĩa hơn "mat_khau" cũ, nhấn mạnh không phải plaintext.
  passwordHash String  @map("password_hash")

  /// enum AdminRole: "SUPERADMIN" | "ADMIN" | "EDITOR"
  role String @default("ADMIN")

  /// Mảng JSON các href trang quản trị được phép truy cập, vd ["/admin/san-pham"].
  /// NULL = toàn quyền (mặc định cho user cũ/tạo mới) — bị bỏ qua hoàn toàn với role
  /// "SUPERADMIN", vai trò này luôn toàn quyền bất kể cột này chứa gì.
  permissions String? @map("permissions")

  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("admin_users")
}

model SiteSetting {
  id          Int     @id @default(autoincrement())
  key         String  @unique
  value       String?
  description String?

  @@map("site_settings")
}

/// Cấu hình SEO dạng single-row (luôn dùng id = 1, xem lib/seo-settings.ts) - đọc bởi
/// RootLayout.generateMetadata() để dựng thẻ <head> cho trang chủ; một số field (og:image,
/// twitter:image, logo...) cũng có thể tái dùng ở trang khác khi cần.
model SeoSetting {
  id Int @id @default(1)

  // Thẻ SEO cốt lõi
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  canonicalUrl    String? @map("canonical_url")
  robotsMeta      String  @default("index, follow") @map("robots_meta")

  // Open Graph & Twitter Card
  ogType             String  @default("website") @map("og_type")
  ogUrl              String? @map("og_url")
  ogTitle            String? @map("og_title")
  ogDescription      String? @map("og_description")
  ogImage            String? @map("og_image")
  twitterCard        String  @default("summary_large_image") @map("twitter_card")
  twitterTitle       String? @map("twitter_title")
  twitterDescription String? @map("twitter_description")
  twitterImage       String? @map("twitter_image")

  // Logo & Favicon
  logoUrl           String? @map("logo_url")
  faviconUrl        String  @default("/favicon.ico") @map("favicon_url")
  appleTouchIconUrl String  @default("/apple-touch-icon.png") @map("apple_touch_icon_url")

  /// enum StructuredDataType: "Organization" | "LocalBusiness" | "WebSite" | "Product" | "BreadcrumbList"
  structuredDataType String  @default("Organization") @map("structured_data_type")
  structuredDataJson String? @map("structured_data_json")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("seo_settings")
}

/// Nhật ký sự kiện bảo mật (đăng nhập thất bại, bị chặn do rate-limit, từ chối quyền truy cập)
/// - ghi bởi lib/security-log.ts, best-effort (không throw), phục vụ truy vết khi có sự cố.
model SecurityLog {
  id Int @id @default(autoincrement())

  /// enum SecurityEventType: "LOGIN_FAILED" | "LOGIN_RATE_LIMITED" | "PERMISSION_DENIED"
  eventType String  @map("event_type")
  detail    String?
  ipAddress String? @map("ip_address")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([createdAt])
  @@map("security_logs")
}
