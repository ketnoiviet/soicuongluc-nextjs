# SQLite - chỉ cần 1 dòng này, không cần cài server DB
DATABASE_URL="file:./dev.db"

# Email gửi form liên hệ (nodemailer + Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_TO="sales@harifavn.com"

# Next.js
NEXT_PUBLIC_SITE_URL="https://soicuongluc.com"
NEXT_PUBLIC_SITE_NAME="Sợi cường lực HARIFA"

# ===== ADMIN / AUTH =====
# Khóa bí mật để ký JWT phiên đăng nhập admin - đổi thành chuỗi ngẫu nhiên dài khi deploy thật
JWT_SECRET="doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien"

# Tài khoản admin mặc định được tạo khi chạy `npm run db:seed` (chỉ áp dụng nếu email chưa tồn tại)
# Đây là tài khoản dành cho khách hàng (chủ website), role ADMIN - không phải superadmin.
ADMIN_EMAIL="admin@harifavn.com"
ADMIN_PASSWORD="Admin@123"

# Tài khoản superadmin ẩn (role SUPERADMIN, dành riêng cho nhà phát triển) - toàn quyền,
# không hiện ra và không quản lý được từ tài khoản ADMIN trở xuống (xem lib/permissions.ts).
# Không có giá trị mặc định cứng trong code (khác với ADMIN_EMAIL/ADMIN_PASSWORD ở trên) -
# bỏ trống 2 dòng này thì seed sẽ bỏ qua việc tạo superadmin.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
