# SQLite - chỉ cần 1 dòng này, không cần cài server DB
DATABASE_URL="file:./dev.db"

# Email gửi form liên hệ (nodemailer + Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_TO="your-email@gmail.com"

# Next.js
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_NAME="Tên website"

# ===== ADMIN / AUTH =====
# Khóa bí mật để ký JWT phiên đăng nhập admin - đổi thành chuỗi ngẫu nhiên dài khi deploy thật
JWT_SECRET="doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien"

# Tài khoản admin mặc định được tạo khi chạy `npm run db:seed` (chỉ áp dụng nếu email chưa tồn tại)
# Đây là tài khoản dành cho khách hàng (chủ website), role ADMIN - không phải superadmin.
# QUAN TRỌNG: chỉ đặt HASH bcrypt ở đây, không đặt mật khẩu thô - nếu .env/source bị lộ (vd.
# hosting đọc trộm), kẻ tấn công chỉ có hash chứ không có mật khẩu dùng đăng nhập ngay được.
# Tạo hash: node scripts/hash-password.js "MatKhauCuaBan"
# Để trống thì seed dùng mật khẩu mặc định "Admin@123" - BẮT BUỘC đổi ngay sau khi đăng nhập.
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD_HASH=""

# Tài khoản superadmin ẩn (role SUPERADMIN, dành riêng cho nhà phát triển) - toàn quyền,
# không hiện ra và không quản lý được từ tài khoản ADMIN trở xuống (xem lib/permissions.ts).
# Không có giá trị mặc định cứng trong code (khác với ADMIN_PASSWORD_HASH ở trên) - bỏ trống
# 2 dòng này thì seed sẽ bỏ qua việc tạo superadmin. Cũng chỉ đặt HASH, không đặt mật khẩu thô -
# và nên dùng một mật khẩu RIÊNG cho mỗi website deploy, không tái sử dụng giữa các dự án.
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD_HASH=""
